NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required only by trusted scripts/server administration.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# One-time deployment secret used by scripts/bootstrap-owner.ts.
OWNER_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
# Optional. USDA offers an API key; create and supply it yourself if desired.
USDA_FDC_API_KEY=
# Required by Open Food Facts etiquette; identifies this app and a contact email.
OPEN_FOOD_FACTS_USER_AGENT=NourishLens/0.1 (your-email@example.com)
# Free local-only photo analysis. Install Ollama and pull this model yourself.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=gemma3:4b
# Stripe remains disabled until you personally configure and enable it.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
